# =====================================================
# Teachers 프로젝트 루트 .gitignore
# (record-api, record-helper 등 여러 하위 프로젝트 공통)
# =====================================================

# ---------- 개발 도구 (소스 아님) ----------
apache-maven-*/
maven/
gradle-*/
jdk-*/
node-v*/

# ---------- 비밀 값 (절대 커밋 금지) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
secrets/
application-local.yml
application-local.yaml
application-local.properties
application-secret*.yml
application-secret*.properties
*-credentials.json
service-account*.json

# ---------- Java / Maven / Gradle ----------
target/
build/
out/
.gradle/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------- Node / Vite / React ----------
node_modules/
dist/
dist-ssr/
.vite/
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
coverage/
.nyc_output/

# ---------- 로그 / 임시 파일 ----------
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# ---------- IntelliJ IDEA ----------
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# ---------- VS Code ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# ---------- Eclipse / STS ----------
.classpath
.project
.settings/
.apt_generated/
.factorypath
.springBeans
.sts4-cache/
bin/

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ---------- 압축·산출물 ----------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ---------- 업로드·개인 데이터 (학생 정보 보호) ----------
# 학생 명단, 생기부 원본, 점검용 샘플은 저장소에 올리지 않습니다.
uploads/
samples-private/
*.hwp
*.hwpx
*.xlsx
*.xls
*.csv
!**/test-fixtures/*.csv
